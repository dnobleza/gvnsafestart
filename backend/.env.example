NODE_ENV=development
PORT=4000

# pgAdmin 4 / local Postgres
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/safestart?schema=public
# Separate database for Jest (npm test refuses to run without it)
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/safestart_test?schema=public

# Two different random values, e.g. from:
#   node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10
# per-IP cap on the public instructor/location catalogue, same window
PUBLIC_RATE_LIMIT_MAX=300
BCRYPT_ROUNDS=12
LOG_LEVEL=debug

# Social login. Optional -- the API boots without them and the matching
# endpoint returns PROVIDER_NOT_CONFIGURED (503) until they are filled in.
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Phone (mobile number) login
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_LENGTH=6
# max OTP requests per window, per IP + phone pair
OTP_RATE_LIMIT_MAX=5
# console = OTP is written to the server log instead of being texted
SMS_PROVIDER=console

# Booking notification emails. console = written to the server log.
# smtp = sent through the SMTP server below (SMTP_HOST required).
EMAIL_PROVIDER=console
EMAIL_FROM=GVN-Safestart <no-reply@gvnsafestart.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Online payments. fake = local checkout for development (refused in
# production); paymongo = real PayMongo Checkout Sessions.
PAYMENT_PROVIDER=fake
# From the PayMongo dashboard: Developers > API keys (sk_test_... / sk_live_...)
PAYMONGO_SECRET_KEY=
# From Developers > Webhooks after creating a webhook that points at
#   https://<your-api-host>/api/v1/payments/webhooks/paymongo
# with the event checkout_session.payment.paid
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_API_BASE=https://api.paymongo.com/v1
# Where PayMongo sends the client back after checkout (the frontend origin)
APP_BASE_URL=http://localhost:5173
# Public address of this API. PayMongo must reach the webhook here, so for
# local testing point it at a tunnel (e.g. cloudflared / ngrok) to port 4000.
API_PUBLIC_URL=http://localhost:4000
# Signs webhooks for the fake provider only (dev). Optional; has a dev default.
# FAKE_PAYMENT_WEBHOOK_SECRET=

# Turns "Use my current location" coordinates into a barangay/city name.
# nominatim = OpenStreetMap (free; requires a contact email per its policy)
GEOCODER_PROVIDER=nominatim
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
GEOCODER_CONTACT_EMAIL=

# IANA zone used for "today" / "this month" in admin reporting
APP_TIMEZONE=Asia/Manila

# Used only by `npm run db:seed` (refuses to run in production). The password
# must meet the normal password rules.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
