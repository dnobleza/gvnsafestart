generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  INSTRUCTOR
  CLIENT
}

enum RequestStatus {
  PENDING
  APPROVED
  IN_PROGRESS
  COMPLETED
  REJECTED
  CANCELLED
}

enum BillingCycle {
  ONE_TIME
  MONTHLY
  YEARLY
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  VOID
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum BookingAction {
  CREATED
  CONFIRMED
  RESCHEDULED
  COMPLETED
  NO_SHOW
  CANCELLED
  CASH_RECORDED
  PAYMENT_RECEIVED
}

enum ActorRole {
  ADMIN
  INSTRUCTOR
  CLIENT
  SYSTEM
}

enum PaymentMethod {
  ONLINE
  CASH
}

enum BookingPaymentStatus {
  UNPAID
  AWAITING_CASH
  PAID
  REFUNDED
}

enum TrainingType {
  OWN_CAR
  CAR_RENTAL
}

enum PackagePaymentStatus {
  UNPAID
  AWAITING_CASH
  RESERVED
  PAID
  REFUNDED
}

enum PackageStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PAID
  PENDING
  FAILED
  REFUNDED
  VOIDED
}

enum VoidRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AuthProvider {
  LOCAL
  GOOGLE
  FACEBOOK
  PHONE
}

model User {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email              String?  @unique
  passwordHash       String?  @map("password_hash")
  role               UserRole
  fullName           String   @map("full_name")
  phone              String?  @unique
  isActive           Boolean  @default(true) @map("is_active")
  mustChangePassword Boolean  @default(false) @map("must_change_password")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  clientProfile      ClientProfile?
  refreshTokens      RefreshToken[]
  authIdentities     AuthIdentity[]
  clientRequests     ServiceRequest[]         @relation("ClientRequests")
  instructorRequests ServiceRequest[]         @relation("AssignedRequests")
  statusChanges      RequestStatusHistory[]
  invoices           Invoice[]
  bookings           Booking[]
  payments           Payment[]
  auditLogs          AuditLog[]
  instructorProfile  InstructorProfile?
  instructorBookings Booking[]                @relation("InstructorBookings")
  bookingActions     Booking[]                @relation("BookingLastAction")
  bookingChanges     BookingHistory[]
  availability       InstructorAvailability[]
  daysOff            InstructorDayOff[]
  notesWritten       ClientNote[]             @relation("NoteInstructor")
  notesAbout         ClientNote[]             @relation("NoteClient")
  notifications      Notification[]
  ratingsGiven       Rating[]                 @relation("RatingClient")
  ratingsReceived    Rating[]                 @relation("RatingInstructor")
  paymentsRecorded   Payment[]                @relation("PaymentRecordedBy")
  voidRequests       CashVoidRequest[]        @relation("VoidRequestedBy")
  voidReviews        CashVoidRequest[]        @relation("VoidReviewedBy")
  settingsUpdated    AppSetting[]             @relation("SettingUpdatedBy")
  clientPackages     ClientPackage[]          @relation("PackageClient")
  instructorPackages ClientPackage[]          @relation("PackageInstructor")

  @@index([role])
  @@map("users")
}

model Registration {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String?      @unique
  phone          String?      @unique
  passwordHash   String?      @map("password_hash")
  fullName       String       @map("full_name")
  role           UserRole     @default(CLIENT)
  provider       AuthProvider @default(LOCAL)
  providerUserId String?      @map("provider_user_id")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([provider, providerUserId])
  @@index([createdAt])
  @@map("registrations")
}

model AuthIdentity {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  provider       AuthProvider
  providerUserId String       @map("provider_user_id")
  email          String?
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
  @@map("auth_identities")
}

model PhoneOtp {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone      String
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([phone, expiresAt])
  @@map("phone_otps")
}

model ClientProfile {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @unique @map("user_id") @db.Uuid
  companyName    String?  @map("company_name")
  billingAddress String?  @map("billing_address")
  savedCity      String?  @map("saved_city")
  savedLatitude  Decimal? @map("saved_latitude") @db.Decimal(9, 6)
  savedLongitude Decimal? @map("saved_longitude") @db.Decimal(9, 6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("client_profiles")
}

model Service {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug         String       @unique
  name         String
  description  String?
  price        Decimal      @db.Decimal(12, 2)
  currency     String       @default("USD") @db.Char(3)
  billingCycle BillingCycle @map("billing_cycle")
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  requests ServiceRequest[]

  @@index([isActive])
  @@map("services")
}

model ServiceRequest {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId             String        @map("client_id") @db.Uuid
  serviceId            String        @map("service_id") @db.Uuid
  assignedInstructorId String?       @map("assigned_instructor_id") @db.Uuid
  status               RequestStatus @default(PENDING)
  title                String
  details              String?
  requestedAt          DateTime      @default(now()) @map("requested_at") @db.Timestamptz(6)
  completedAt          DateTime?     @map("completed_at") @db.Timestamptz(6)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  client             User                   @relation("ClientRequests", fields: [clientId], references: [id], onDelete: Restrict)
  service            Service                @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  assignedInstructor User?                  @relation("AssignedRequests", fields: [assignedInstructorId], references: [id], onDelete: SetNull)
  statusHistory      RequestStatusHistory[]
  invoices           Invoice[]

  @@index([clientId, status])
  @@index([assignedInstructorId])
  @@index([serviceId])
  @@map("service_requests")
}

model RequestStatusHistory {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId   String         @map("request_id") @db.Uuid
  fromStatus  RequestStatus? @map("from_status")
  toStatus    RequestStatus  @map("to_status")
  changedById String?        @map("changed_by_id") @db.Uuid
  note        String?
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  request   ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  changedBy User?          @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([requestId])
  @@map("request_status_history")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  userAgent String?   @map("user_agent")
  ip        String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Invoice {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceNumber    String        @unique @map("invoice_number")
  clientId         String        @map("client_id") @db.Uuid
  serviceRequestId String?       @map("service_request_id") @db.Uuid
  status           InvoiceStatus @default(DRAFT)
  currency         String        @default("USD") @db.Char(3)
  subtotal         Decimal       @db.Decimal(12, 2)
  tax              Decimal       @default(0) @db.Decimal(12, 2)
  total            Decimal       @db.Decimal(12, 2)
  issuedAt         DateTime?     @map("issued_at") @db.Timestamptz(6)
  dueAt            DateTime?     @map("due_at") @db.Timestamptz(6)
  paidAt           DateTime?     @map("paid_at") @db.Timestamptz(6)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  client         User            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  serviceRequest ServiceRequest? @relation(fields: [serviceRequestId], references: [id], onDelete: SetNull)
  items          InvoiceItem[]

  @@index([clientId, status])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId   String   @map("invoice_id") @db.Uuid
  description String
  quantity    Decimal  @default(1) @db.Decimal(12, 2)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  lineTotal   Decimal  @map("line_total") @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model Booking {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId        String               @map("client_id") @db.Uuid
  lessonType      String               @map("lesson_type")
  area            String?
  scheduledAt     DateTime             @map("scheduled_at") @db.Timestamptz(6)
  durationMinutes Int                  @default(60) @map("duration_minutes")
  status          BookingStatus        @default(PENDING)
  notes           String?
  cancelReason    String?              @map("cancel_reason")
  instructorId    String?              @map("instructor_id") @db.Uuid
  lastActionById  String?              @map("last_action_by") @db.Uuid
  lastActionAt    DateTime?            @map("last_action_at") @db.Timestamptz(6)
  paymentMethod   PaymentMethod        @default(CASH) @map("payment_method")
  paymentStatus   BookingPaymentStatus @default(AWAITING_CASH) @map("payment_status")
  price           Decimal?             @db.Decimal(12, 2)
  paymentDueAt    DateTime?            @map("payment_due_at") @db.Timestamptz(6)
  clientPackageId String?              @map("client_package_id") @db.Uuid
  sessionNumber   Int?                 @map("session_number")
  autoCompleted   Boolean              @default(false) @map("auto_completed")
  autoCompletedAt DateTime?            @map("auto_completed_at") @db.Timestamptz(6)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  clientPackage ClientPackage?   @relation(fields: [clientPackageId], references: [id], onDelete: SetNull)
  client        User             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  instructor    User?            @relation("InstructorBookings", fields: [instructorId], references: [id], onDelete: Restrict)
  lastActionBy  User?            @relation("BookingLastAction", fields: [lastActionById], references: [id], onDelete: SetNull)
  payments      Payment[]
  history       BookingHistory[]
  notifications Notification[]
  rating        Rating?

  @@index([scheduledAt])
  @@index([status, scheduledAt])
  @@index([clientId])
  @@index([instructorId, scheduledAt])
  @@index([paymentStatus, paymentDueAt])
  @@index([clientPackageId])
  @@index([autoCompletedAt])
  @@map("bookings")
}

model Payment {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId         String?       @map("booking_id") @db.Uuid
  clientId          String        @map("client_id") @db.Uuid
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("PHP") @db.Char(3)
  status            PaymentStatus
  method            String?
  reference         String?
  paidAt            DateTime?     @map("paid_at") @db.Timestamptz(6)
  recordedById      String?       @map("recorded_by") @db.Uuid
  voidedAt          DateTime?     @map("voided_at") @db.Timestamptz(6)
  provider          String?
  providerReference String?       @unique @map("provider_reference")
  checkoutUrl       String?       @map("checkout_url")
  expiresAt         DateTime?     @map("expires_at") @db.Timestamptz(6)
  clientPackageId   String?       @map("client_package_id") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  clientPackage ClientPackage?    @relation(fields: [clientPackageId], references: [id], onDelete: SetNull)
  booking       Booking?          @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  client        User              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  recordedBy    User?             @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  voidRequests  CashVoidRequest[]

  @@index([status, createdAt])
  @@index([recordedById, createdAt])
  @@index([clientId])
  @@index([clientPackageId])
  @@map("payments")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actorEmail String   @map("actor_email")
  action     String
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  metadata   Json     @default("{}")
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action])
  @@index([actorId])
  @@map("audit_logs")
}

model Branch {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  instructorProfiles InstructorProfile[]

  @@map("branches")
}

model InstructorProfile {
  userId    String   @id @map("user_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  street    String
  barangay  String
  city      String
  province  String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([branchId])
  @@map("instructor_profiles")
}

model BookingHistory {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId      String         @map("booking_id") @db.Uuid
  action         BookingAction
  fromStatus     BookingStatus? @map("from_status")
  toStatus       BookingStatus? @map("to_status")
  oldScheduledAt DateTime?      @map("old_scheduled_at") @db.Timestamptz(6)
  newScheduledAt DateTime?      @map("new_scheduled_at") @db.Timestamptz(6)
  reason         String?
  changedById    String?        @map("changed_by") @db.Uuid
  changedByRole  ActorRole      @map("changed_by_role")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  changedBy User?   @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([bookingId, createdAt])
  @@index([changedById])
  @@map("booking_history")
}

model InstructorAvailability {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  instructorId String   @map("instructor_id") @db.Uuid
  dayOfWeek    Int      @map("day_of_week") @db.SmallInt
  startTime    String   @map("start_time") @db.VarChar(5)
  endTime      String   @map("end_time") @db.VarChar(5)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  instructor User @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@index([instructorId, dayOfWeek])
  @@map("instructor_availability")
}

model InstructorDayOff {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  instructorId String   @map("instructor_id") @db.Uuid
  date         DateTime @db.Date
  reason       String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  instructor User @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@unique([instructorId, date])
  @@map("instructor_days_off")
}

model ClientNote {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  instructorId String   @map("instructor_id") @db.Uuid
  clientId     String   @map("client_id") @db.Uuid
  note         String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  instructor User @relation("NoteInstructor", fields: [instructorId], references: [id], onDelete: Cascade)
  client     User @relation("NoteClient", fields: [clientId], references: [id], onDelete: Cascade)

  @@index([instructorId, clientId, createdAt])
  @@map("client_notes")
}

model Notification {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String
  title     String
  message   String
  bookingId String?  @map("booking_id") @db.Uuid
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, isRead])
  @@map("notifications")
}

model Rating {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId    String    @unique @map("booking_id") @db.Uuid
  clientId     String    @map("client_id") @db.Uuid
  instructorId String    @map("instructor_id") @db.Uuid
  stars        Int       @db.SmallInt
  comment      String?   @db.VarChar(500)
  isHidden     Boolean   @default(false) @map("is_hidden")
  excludedAt   DateTime? @map("excluded_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  client     User    @relation("RatingClient", fields: [clientId], references: [id], onDelete: Restrict)
  instructor User    @relation("RatingInstructor", fields: [instructorId], references: [id], onDelete: Restrict)

  @@index([instructorId, createdAt])
  @@map("ratings")
}

model CashVoidRequest {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId     String            @map("payment_id") @db.Uuid
  requestedById String            @map("requested_by") @db.Uuid
  reason        String
  status        VoidRequestStatus @default(PENDING)
  reviewedById  String?           @map("reviewed_by") @db.Uuid
  reviewedAt    DateTime?         @map("reviewed_at") @db.Timestamptz(6)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  payment     Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  requestedBy User    @relation("VoidRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy  User?   @relation("VoidReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([paymentId])
  @@index([status, createdAt])
  @@map("cash_void_requests")
}

model PaymentEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider   String
  eventId    String   @map("event_id")
  type       String
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  @@unique([provider, eventId])
  @@map("payment_events")
}

model AppSetting {
  key         String   @id
  value       Json
  updatedById String?  @map("updated_by") @db.Uuid
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  updatedBy User? @relation("SettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("app_settings")
}

model ServiceArea {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  rates          PackageRate[]
  clientPackages ClientPackage[]

  @@map("service_areas")
}

model Package {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String   @unique
  name            String
  description     String?
  sessions        Int
  hoursPerSession Int      @map("hours_per_session")
  isActive        Boolean  @default(true) @map("is_active")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  rates          PackageRate[]
  clientPackages ClientPackage[]

  @@map("packages")
}

model PackageRate {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  packageId     String       @map("package_id") @db.Uuid
  serviceAreaId String       @map("service_area_id") @db.Uuid
  trainingType  TrainingType @map("training_type")
  price         Decimal      @db.Decimal(12, 2)
  updatedAt     DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  package     Package     @relation(fields: [packageId], references: [id], onDelete: Cascade)
  serviceArea ServiceArea @relation(fields: [serviceAreaId], references: [id], onDelete: Cascade)

  @@unique([packageId, serviceAreaId, trainingType])
  @@map("package_rates")
}

model ClientPackage {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId          String               @map("client_id") @db.Uuid
  packageId         String               @map("package_id") @db.Uuid
  serviceAreaId     String               @map("service_area_id") @db.Uuid
  trainingType      TrainingType         @map("training_type")
  instructorId      String               @map("instructor_id") @db.Uuid
  packageName       String               @map("package_name")
  price             Decimal              @db.Decimal(12, 2)
  sessionsTotal     Int                  @map("sessions_total")
  minutesPerSession Int                  @map("minutes_per_session")
  pickupAddress     String               @map("pickup_address")
  paymentMethod     PaymentMethod        @map("payment_method")
  reservationFee    Decimal              @map("reservation_fee") @db.Decimal(12, 2)
  amountPaid        Decimal              @default(0) @map("amount_paid") @db.Decimal(12, 2)
  paymentStatus     PackagePaymentStatus @map("payment_status")
  paymentDueAt      DateTime?            @map("payment_due_at") @db.Timestamptz(6)
  status            PackageStatus        @default(ACTIVE)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  client      User        @relation("PackageClient", fields: [clientId], references: [id], onDelete: Restrict)
  instructor  User        @relation("PackageInstructor", fields: [instructorId], references: [id], onDelete: Restrict)
  package     Package     @relation(fields: [packageId], references: [id], onDelete: Restrict)
  serviceArea ServiceArea @relation(fields: [serviceAreaId], references: [id], onDelete: Restrict)
  bookings    Booking[]
  payments    Payment[]

  @@index([clientId, createdAt])
  @@index([paymentStatus, paymentDueAt])
  @@map("client_packages")
}

model ReceiptCounter {
  year       Int @id
  lastNumber Int @map("last_number")

  @@map("receipt_counters")
}

model CronRun {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  job             String
  trigger         String
  status          String
  startedAt       DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt      DateTime? @map("finished_at") @db.Timestamptz(6)
  completedCount  Int       @default(0) @map("completed_count")
  cancelledCount  Int       @default(0) @map("cancelled_count")
  cashUnpaidCount Int       @default(0) @map("cash_unpaid_count")
  error           String?

  @@index([job, startedAt(sort: Desc)])
  @@map("cron_runs")
}
